# ─── HTTP Server ─────────────────────────────────────────────────
PORT=3001

# ─── CognoDB / Neo4j Connection ──────────────────────────────────
# Local: bolt://localhost:7687
# Hosted CognoDB: bolt+ssc://<host>:7687 or neo4j+s://<host>:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here
NEO4J_DATABASE=neo4j

# ─── CORS ────────────────────────────────────────────────────────
# Must exactly match your frontend origin (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ─── App Config ──────────────────────────────────────────────────
NODE_ENV=development
# One of: error | warn | info | debug
LOG_LEVEL=info

# ─── Auth / Sessions ─────────────────────────────────────────────
# IMPORTANT: Replace this with a long random string in production!
# Generate one with: openssl rand -hex 32
SESSION_SECRET=blast-radius-dev-secret-change-in-prod
# Session TTL in milliseconds. Default: 86400000 (24 hours)
SESSION_MAX_AGE_MS=86400000

